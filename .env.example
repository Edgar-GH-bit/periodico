# Copia este archivo como ".env" y rellena tus propios valores.
# El archivo ".env" NUNCA debe subirse a GitHub (ya está en .gitignore).

PORT=3000

# Cadena de conexión de tu base PostgreSQL (Render te la da al crear la base)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_basedatos

# Clave secreta para firmar los tokens JWT. Genera una larga y aleatoria, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Dominio(s) de tu frontend en producción, separados por coma. Ej:
# FRONTEND_ORIGIN=https://periodico-azteca.onrender.com
FRONTEND_ORIGIN=

NODE_ENV=development
